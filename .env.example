# ---------------------------------------------------------------------------
# Vorlage fuer die Environment Variables in Vercel.
# Diese Datei enthaelt nur Platzhalter und wird mit ins Repository eingecheckt.
# Die echten Werte NIE hier eintragen, sondern in Vercel unter
# Settings -> Environment Variables, fuer Production, Preview und Development.
# ---------------------------------------------------------------------------

# --- SMTP-Zugang: ueber dieses Postfach verschickt die Seite die Formularmails
# Das sind die Zugangsdaten des IONOS-Postfachs der Praxis.
SMTP_HOST=smtp.ionos.de
SMTP_PORT=465
SMTP_SECURE=true            # true bei Port 465 (SSL), false bei Port 587 (STARTTLS)
SMTP_USER=info@krankengymnastik-in-hannover.de
SMTP_PASS=das-passwort-des-postfachs

# --- Absender der Formularmails
# MUSS die Adresse des SMTP-Postfachs bleiben. Traegt man hier eine
# Fremdadresse ein (etwa eine rocketmail-Adresse), passt der Absender nicht
# mehr zu SPF und DKIM der Domain. Die Mail wird dann als gefaelscht gewertet
# und landet im Spam oder wird ganz abgelehnt.
CONTACT_FROM=info@krankengymnastik-in-hannover.de

# --- Empfaenger der Formularmails
# Hierhin gehen Terminanfragen und Bewerbungen. Darf eine beliebige Adresse
# sein, auch bei einem anderen Anbieter. Die Antwortadresse wird automatisch
# auf den Absender des Formulars gesetzt, ein Klick auf Antworten geht also
# direkt an den Patienten oder Bewerber.
CONTACT_TO=tareckfares@rocketmail.com

# --- Oeffentliche Basis-URL (fuer canonical, Sitemap und Vorschaubilder)
NEXT_PUBLIC_SITE_URL=https://www.krankengymnastik-in-hannover.de
