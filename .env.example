# ---------------------------------------------------------------------------
# Vorlage fuer die Environment Variables in Vercel.
# Diese Datei enthaelt nur Platzhalter und wird mit ins Repository eingecheckt.
# Die echten Werte NIE hier eintragen, sondern in Vercel unter
# Settings -> Environment Variables, fuer Production, Preview und Development.
# ---------------------------------------------------------------------------

# --- Versand ueber das Rocketmail-Postfach (Yahoo)
#
# Die Formularmails werden ueber das Postfach verschickt, an das sie auch
# gehen sollen. Das Postfach schickt sich die Anfragen also selbst zu.
# Ein IONOS-Zugang wird dafuer nicht gebraucht.
#
# WICHTIG: Yahoo akzeptiert hier NICHT das normale Anmeldepasswort, sondern
# verlangt ein eigenes App-Passwort. Zu finden im Yahoo-Konto unter
# Kontoinfo -> Sicherheit -> App-Passwort generieren. Das erzeugte
# 16-stellige Passwort kommt unten bei SMTP_PASS hinein.
SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tareckfares@rocketmail.com
SMTP_PASS=das-16-stellige-app-passwort-von-yahoo

# --- Absender der Formularmails
# Muss dieselbe Adresse sein wie SMTP_USER. Yahoo lehnt Mails ab, deren
# Absender nicht zum angemeldeten Postfach passt.
CONTACT_FROM=tareckfares@rocketmail.com

# --- Empfaenger der Formularmails
# Hierhin gehen Terminanfragen und Bewerbungen. Die Antwortadresse wird
# automatisch auf den Absender des Formulars gesetzt, ein Klick auf
# Antworten geht also direkt an den Patienten oder Bewerber.
CONTACT_TO=tareckfares@rocketmail.com

# --- Oeffentliche Basis-URL (fuer canonical, Sitemap und Vorschaubilder)
NEXT_PUBLIC_SITE_URL=https://www.krankengymnastik-in-hannover.de
